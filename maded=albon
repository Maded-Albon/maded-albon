            }
        };

        function getAllFarms() {
            let customFarms = JSON.parse(localStorage.getItem('user_added_farms') || '{}');
            return Object.assign({}, defaultFarms, customFarms);
        }

        function renderGeoMap() {
            const container = document.getElementById('ovalMapContainer');
            const labelsHTML = `
                <span class="val-label val-rwam">روام ووسان</span>
                <span class="val-label val-aows">وادي العوص</span>
                <span class="val-label val-zhrah">وادي الظهرة</span>
                <span class="val-label val-rtham">حسوة ورثام</span>
            `;
            container.innerHTML = labelsHTML;

            const allFarms = getAllFarms();
            const keys = Object.keys(allFarms);

            const countEl = document.getElementById('totalFarmsCount');
            if(countEl) countEl.innerText = keys.length;

            keys.forEach((key, index) => {
                const farm = allFarms[key];
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `farm-geo-card ${index === 0 ? 'active' : ''}`;
                btn.onclick = function() { loadFarmData(key, this); };
                btn.innerHTML = `<i class="fa-solid fa-tree"></i> ${farm.name}`;
                container.appendChild(btn);

                if (index < keys.length - 1) {
                    const arrow = document.createElement('div');
                    arrow.className = 'card-arrow';
                    container.appendChild(arrow);
                }
            });
        }

        function loadFarmData(key, element) {
            document.querySelectorAll('.farm-geo-card').forEach(btn => btn.classList.remove('active'));
            if(element) element.classList.add('active');

            const allFarms = getAllFarms();
            const farm = allFarms[key];
            const displayArea = document.getElementById('farmDetailsDisplay');

            if(farm) {
                displayArea.innerHTML = `
                    <h2 class="farm-title-header">${farm.name}</h2>
                    <span class="location-badge"><i class="fa-solid fa-location-dot"></i> ${farm.location}</span>
                    
                    <div class="info-cards-grid">
                        <div class="info-card-item">
                            <div class="value">${farm.trees} شجرة</div>
                            <div class="label"><i class="fa-solid fa-tree"></i> عدد الأشجار</div>
                        </div>
                        <div class="info-card-item">
                            <div class="value">${farm.height}</div>
                            <div class="label"><i class="fa-solid fa-mountain"></i> الارتفاع عن سطح البحر</div>
                        </div>
                    </div>

                    <a href="${farm.map}" target="_blank" rel="noopener noreferrer" class="google-map-btn">
                        <i class="fa-solid fa-map-location-dot"></i> فتح موقع المزرعة على خرائط Google
                    </a>
                `;
            }
        }

        function openNafathModal() {
            document.getElementById('nafathID').value = '';
            document.getElementById('nafathStep1').style.display = 'block';
            document.getElementById('nafathStep2').style.display = 'none';
            document.getElementById('nafathModal').style.display = 'flex';
        }

        function proceedToNafathCode() {
            const idNumber = document.getElementById('nafathID').value.trim();
            if (!idNumber || idNumber.length < 5) {
                alert('الرجاء إدخال رقم الهوية الوطنية بشكل صحيح!');
                return;
            }

            // توليد رقم نفاذ العشوائي والانتقال للخطوة الثانية
            const code = Math.floor(10 + Math.random() * 89);
            document.getElementById('nafathCode').innerText = code;
            document.getElementById('nafathStep1').style.display = 'none';
            document.getElementById('nafathStep2').style.display = 'block';
        }

        function confirmNafathLogin() {
            const idNumber = document.getElementById('nafathID').value.trim();
            // استخراج اسم افتراضي موثق بناءً على رقم الهوية أو كمستخدم موثق رسمياً
            const verifiedName = "المواطن / الموثق (هوية: " + idNumber.slice(-4) + "****)";

            localStorage.setItem('nafath_auth', 'true');
            localStorage.setItem('nafath_user_name', verifiedName);
            document.getElementById('nafathModal').style.display = 'none';
            applyNafathState();
            alert('تم التحقق بنجاح من هويتك عبر نفاذ الوطني الموحد! أهلاً بك.');
        }

        function logoutNafath() {
            localStorage.removeItem('nafath_auth');
            localStorage.removeItem('nafath_user_name');
            applyNafathState();
        }

        function applyNafathState() {
            const auth = localStorage.getItem('nafath_auth') === 'true';
            const userName = localStorage.getItem('nafath_user_name') || '';
            const banners = document.querySelectorAll('.nafath-banner');
            const badges = document.querySelectorAll('.user-logged-badge');
            const protectedForms = document.querySelectorAll('#addQuoteForm, #farmRegisterForm');

            banners.forEach(b => b.style.display = auth ? 'none' : 'block');
            badges.forEach(bg => bg.style.display = auth ? 'flex' : 'none');
            
            if (auth) {
                document.getElementById('loggedInUserName').innerText = userName;
                document.getElementById('loggedInUserNameFarm').innerText = userName;
            }

            protectedForms.forEach(f => {
                if(f) {
                    f.style.opacity = auth ? '1' : '0.5';
                    f.style.pointerEvents = auth ? 'auto' : 'none';
                }
            });
        }

        function setupVisitorCounter() {
            let count = localStorage.getItem('site_visitors') || 1248;
            count = parseInt(count) + 1;
            localStorage.setItem('site_visitors', count);
            document.getElementById('visitorCount').innerText = count.toLocaleString('ar-SA');
        }

        function loadSavedQuotes() {
            const saved = JSON.parse(localStorage.getItem('user_quotes') || '[]');
            const container = document.getElementById('quotesContainer');
            saved.forEach((q, index) => {
                const card = document.createElement('div');
                card.className = 'quote-card';
                card.innerHTML = `
                    <div class="quote-text">${q.text}</div>
                    <div class="quote-author">
                        <span>— ${q.author}</span>
                        <i class="fa-solid fa-trash" style="color: #c93b2b; cursor: pointer;" onclick="deleteQuote(${index})" title="حذف المشاركة"></i>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function deleteQuote(index) {
            let saved = JSON.parse(localStorage.getItem('user_quotes') || '[]');
            saved.splice(index, 1);
            localStorage.setItem('user_quotes', JSON.stringify(saved));
            location.reload();
        }

        function addNewQuote() {
            if(!localStorage.getItem('nafath_auth')) {
                alert('عذراً! يلزم الدخول عبر نفاذ أولاً.');
                return;
            }

            const textInput = document.getElementById('quoteContent');
            const text = textInput.value.trim();
            const currentName = localStorage.getItem('nafath_user_name') || 'موثق عبر نفاذ';

            if (!text) {
                alert('لطفاً اكتبي الأبيات قبل الإضافة!');
                return;
            }

            const saved = JSON.parse(localStorage.getItem('user_quotes') || '[]');
            saved.push({ text: text, author: currentName });
            localStorage.setItem('user_quotes', JSON.stringify(saved));

            textInput.value = '';
            location.reload();
        }

        function addNewFarm() {
            if(!localStorage.getItem('nafath_auth')) {
                alert('عذراً! يلزم التحقق عبر نفاذ أولاً.');
                return;
            }

            const name = document.getElementById('farmFormName').value.trim();
            const loc = document.getElementById('farmFormLoc').value.trim();
            const trees = document.getElementById('farmFormTrees').value.trim();
            const height = document.getElementById('farmFormHeight').value.trim();
            const mapUrl = document.getElementById('farmFormMap').value.trim();
            const currentName = localStorage.getItem('nafath_user_name') || 'موثق عبر نفاذ';

            if(!name || !loc || !trees || !height) {
                alert('لطفاً املئي كافة حقول المزرعة المطلوبة!');
                return;
            }

            const newKey = 'custom_' + Date.now();
            const newFarmData = {
                name: name,
                location: loc + " (بواسطة: " + currentName + ")",
                trees: trees,
                height: height + " متر",
                map: mapUrl || "https://maps.google.com/?q=Rijal+Al-Alma"
            };

            let customFarms = JSON.parse(localStorage.getItem('user_added_farms') || '{}');
            customFarms[newKey] = newFarmData;
            localStorage.setItem('user_added_farms', JSON.stringify(customFarms));

            renderGeoMap();
            loadFarmData(newKey, document.querySelector(`.farm-geo-card:last-child`));

            document.getElementById('farmFormName').value = '';
            document.getElementById('farmFormLoc').value = '';
            document.getElementById('farmFormTrees').value = '';
            document.getElementById('farmFormHeight').value = '';
            document.getElementById('farmFormMap').value = '';

            alert('تم اعتماد وإضافة المزرعة بنجاح باسمك (' + currentName + ')! ✨☕');
        }

        window.onload = function() {
            renderGeoMap();
            loadFarmData('yasser', document.querySelector('.farm-geo-card'));
            setupVisitorCounter();
            loadSavedQuotes();
            applyNafathState();
        };
    </script>
</body>
